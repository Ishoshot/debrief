# AI provider: openai or gemini. Set the API key for the provider you select.
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Models. If a model of the selected provider is not in its allowlist in internal/config, the service does not start.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe   # Converts the audio to text.
OPENAI_REPORT_MODEL=gpt-6-luna              # Writes the visit report from the text.
GEMINI_MODEL=gemini-3.5-flash               # Writes the transcript and the report from the audio.


# Destination: webhook or hubspot.
# For webhook, get a free test URL at https://webhook.site.
DESTINATION=webhook
WEBHOOK_URL=
# For hubspot, use a service key with these scopes:
# crm.objects.contacts.write, crm.objects.companies.read and crm.objects.companies.write.
HUBSPOT_TOKEN=


# Service settings.
PORT=8080        # The HTTP port. Docker Compose also opens it on your computer.
WORKERS=4        # The number of workers in one instance. Each worker processes one job at a time.
MAX_ATTEMPTS=5   # The maximum number of attempts for a job.
